{
    "hosting": {
        "public": "public",
        "cleanUrls": true,
        "rewrites": [
            {
            "source": "/writing/**",
            "destination": "/writing.html"
            },
            {
            "source": "/post/**",
            "destination": "/post.html"
            },
            {
            "source": "/book/**",
            "destination": "/book.html"
            },
            {
            "source": "/getRecentPosts",
            "function": "mlw_app"
            },
            {
            "source": "/getAllPosts",
            "function": "mlw_app"
            },
            {
            "source": "/getAllPosts/**",
            "function": "mlw_app"
            },
            {
            "source": "/getPost/**",
            "function": "mlw_app"
            },
            {
            "source": "/getAllBooks",
            "function": "mlw_app"
            },
            {
            "source": "/getAllSeries",
            "function": "mlw_app"
            },
            {
            "source": "/getAllStandaloneBooks",
            "function": "mlw_app"
            },
            {
            "source": "/getBook/**",
            "function": "mlw_app"
            },
            {
            "source": "/getAboutInfo",
            "function": "mlw_app"
            },
            {
            "source": "**",
            "function": "mlw_app"
            }
        ],
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ]
    },
    "functions": [
        {
        "source": "functions",
        "codebase": "default",
        "ignore": [
            "node_modules",
            ".git",
            "firebase-debug.log",
            "firebase-debug.*.log",
            "*.local"
        ]
        }
    ]
}
